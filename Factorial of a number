#include<iostream>
using namespace std;
long fact(int n);
int main()
{
        int n, factorial=1;
        cout<<"Enter value = ";
        cin>>n;
        factorial=fact(n);
        cout<<"Factorial of "<<n<<" is = "<<factorial;
        return 0;
}
 long fact(int n)
{
        if(n==1)
        return 1;
        else
        return n*fact(n-1);
}
